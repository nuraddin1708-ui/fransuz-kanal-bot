
"""3-agent: Gemini (Nano Banana) orqali post uchun rasm yaratadi."""
from pathlib import Path

import config
from agents import gemini

ASSETS = Path(__file__).resolve().parent.parent / "assets"


def _references():
    """assets/ papkasidagi qahramonlar rasmlari — qahramonlar har doim bir xil ko'rinsin."""
    if not ASSETS.exists():
        return []
    return sorted(p for p in ASSETS.iterdir() if p.suffix.lower() in (".png", ".jpg", ".jpeg"))[:3]


def draw(lesson, out_path, aspect="4:5", variant=""):
    refs = _references()
    prompt = (
        "Warm, bright, high-quality digital illustration for an educational Telegram post. "
        f"Characters: {config.CHARACTERS_EN} "
        f"Scene: {lesson['image_scene']} {variant} "
        "The two young women are talking and smiling, friendly atmosphere. "
        "Modest, family-friendly clothing. No text, no letters, no logos, no watermarks."
    )
    if refs:
        prompt = ("Keep the characters looking exactly like in the reference images. " + prompt)
    return gemini.image(prompt, out_path, aspect=aspect, references=refs)

"""Gemini API bilan ishlash (matn, internet qidiruvi, rasm)."""
import base64
import json
import time
from pathlib import Path

import requests

import config

URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"


def _post(model, body, retries=3):
    if not config.GEMINI_API_KEY:
        raise RuntimeError("GEMINI_API_KEY topilmadi (GitHub Secrets'ga qo'shing)")
    last = None
    for attempt in range(retries):
        r = requests.post(
            URL.format(model=model),
            headers={"x-goog-api-key": config.GEMINI_API_KEY},
            json=body,
            timeout=180,
        )
        if r.status_code == 200:
            return r.json()
        last = f"{r.status_code}: {r.text[:500]}"
        if r.status_code in (429, 500, 502, 503, 504):
            time.sleep(10 * (attempt + 1))
            continue
        break
    raise RuntimeError(f"Gemini xatosi ({model}) — {last}")


def _extract_json(text):
    start, end = text.find("{"), text.rfind("}")
    if start == -1 or end == -1:
        raise ValueError(f"Javobda JSON yo'q: {text[:300]}")
    return json.loads(text[start:end + 1])


def ask(prompt, want_json=False, search=False):
    """Matnli so'rov. search=True bo'lsa, Gemini internetdan qidiradi."""
    body = {"contents": [{"parts": [{"text": prompt}]}]}
    if search:
        body["tools"] = [{"google_search": {}}]
    elif want_json:
        body["generationConfig"] = {"responseMimeType": "application/json"}
    data = _post(config.GEMINI_TEXT_MODEL, body)
    parts = data["candidates"][0]["content"].get("parts", [])
    text = "".join(p.get("text", "") for p in parts)
    return _extract_json(text) if want_json else text


def image(prompt, out_path, aspect="4:5", references=()):
    """Nano Banana orqali rasm yaratadi va faylga saqlaydi."""
    parts = []
    for ref in references:
        mime = "image/png" if str(ref).endswith(".png") else "image/jpeg"
        parts.append({"inlineData": {"mimeType": mime,
                                     "data": base64.b64encode(Path(ref).read_bytes()).decode()}})
    parts.append({"text": prompt})
    body = {
        "contents": [{"parts": parts}],
        "generationConfig": {
            "responseModalities": ["IMAGE"],
            "imageConfig": {"aspectRatio": aspect},
        },
    }
    data = _post(config.GEMINI_IMAGE_MODEL, body)
    for p in data["candidates"][0]["content"].get("parts", []):
        blob = p.get("inlineData") or p.get("inline_data")
        if blob:
            Path(out_path).write_bytes(base64.b64decode(blob["data"]))
            return out_path
    raise RuntimeError("Gemini rasm qaytarmadi")

"""6-agent: admin-bot orqali ogohlantiradi, tahrirlashni qabul qiladi va kanalga chiqaradi."""
import datetime
import html
import json
import time

import requests

import config


def _api(method, files=None, **params):
    url = f"https://api.telegram.org/bot{config.BOT_TOKEN}/{method}"
    for attempt in range(4):
        if files:
            data = {k: (json.dumps(v) if isinstance(v, (dict, list)) else v) for k, v in params.items()}
            handles = {k: open(v, "rb") for k, v in files.items()}
            try:
                r = requests.post(url, data=data, files=handles, timeout=300)
            finally:
                for h in handles.values():
                    h.close()
        else:
            r = requests.post(url, json=params, timeout=60)
        res = r.json()
        if res.get("ok"):
            return res["result"]
        retry = res.get("parameters", {}).get("retry_after")
        if retry:
            time.sleep(retry + 1)
            continue
        raise RuntimeError(f"Telegram xatosi ({method}): {res}")
    raise RuntimeError(f"Telegram ({method}) javob bermadi")


# ---------- Post matnlari ----------

def e(s):
    return html.escape(str(s), quote=False)


def _dialogue_html(lesson):
    rows = []
    for line in lesson["dialogue"]:
        if line["speaker"] == config.FRENCH_GIRL:
            row = f"🇫🇷 <b>{e(line['speaker'])}:</b> <i>{e(line['text'])}</i>"
            if line.get("uz"):
                row += f"\n      ↳ {e(line['uz'])}"
        else:
            row = f"🇺🇿 <b>{e(line['speaker'])}:</b> {e(line['text'])}"
        rows.append(row)
    return "\n\n".join(rows)


def _phrases_html(lesson):
    return "\n".join(
        f"• <b>{e(p['fr'])}</b> [{e(p.get('pron', ''))}] — {e(p.get('uz', ''))}"
        for p in lesson["key_phrases"]
    )


def _footer():
    return f"\n\n{config.HASHTAG}\n{e(config.CHANNEL_TAG)}"


def full_text(lesson):
    return (
        f"🇫🇷🇺🇿 <b>{e(config.RUBRIC)}</b>\n"
        f"<b>{e(lesson['title_uz'])}</b>\n\n"
        f"{_dialogue_html(lesson)}\n\n"
        f"📌 <b>Yodda tuting:</b>\n{_phrases_html(lesson)}\n\n"
        f"💡 {e(lesson['tip_uz'])}"
        + _footer()
    )


def short_caption(lesson, limit=1024):
    """Rasm/video ostidagi matn (Telegram chegarasi — 1024 belgi)."""
    text = (
        f"🇫🇷🇺🇿 <b>{e(lesson['title_uz'])}</b>\n\n"
        f"{_phrases_html(lesson)}\n\n"
        f"💡 {e(lesson['tip_uz'])}"
        + _footer()
    )
    if len(text) > limit:
        text = (f"🇫🇷🇺🇿 <b>{e(lesson['title_uz'])}</b>\n\n{_phrases_html(lesson)}" + _footer())
    return text[:limit]


# ---------- Yuborish ----------

def send_package(chat_id, pkg):
    """pkg: {"kind": "text_audio"|"photo"|"video", "lesson": ..., "files": {...}}"""
    lesson, kind, files = pkg["lesson"], pkg["kind"], pkg["files"]
    if kind == "text_audio":
        _api("sendMessage", chat_id=chat_id, text=full_text(lesson), parse_mode="HTML")
        if files.get("audio"):
            _api("sendAudio", files={"audio": files["audio"]}, chat_id=chat_id,
                 title=lesson["title_uz"], performer=f"{config.UZBEK_GIRL} & {config.FRENCH_GIRL}",
                 caption=f"🎧 {e(lesson['title_uz'])}\n{e(config.CHANNEL_TAG)}", parse_mode="HTML")
    elif kind == "photo":
        _api("sendPhoto", files={"photo": files["photo"]}, chat_id=chat_id,
             caption=short_caption(lesson), parse_mode="HTML")
    elif kind == "video":
        _api("sendVideo", files={"video": files["video"]}, chat_id=chat_id,
             caption=short_caption(lesson), parse_mode="HTML", supports_streaming=True,
             width=1080, height=1920)


def _admin():
    if not config.ADMIN_CHAT_ID:
        raise RuntimeError("ADMIN_CHAT_ID topilmadi (GitHub Secrets'ga qo'shing)")
    return int(config.ADMIN_CHAT_ID)


def _notify(text, **extra):
    return _api("sendMessage", chat_id=_admin(), text=text, parse_mode="HTML", **extra)


def _now():
    return datetime.datetime.now(config.TZ)


def _sleep_until(moment):
    while True:
        left = (moment - _now()).total_seconds()
        if left <= 0:
            return
        time.sleep(min(left, 30))


def _fresh_offset():
    """Eski xabarlarni o'tkazib yuborish uchun."""
    updates = _api("getUpdates", offset=-1, timeout=0)
    return updates[-1]["update_id"] + 1 if updates else None


def run(pkg, publish_at, rebuild, dry_run=False):
    """
    publish_at — kanalga chiqish vaqti.
    rebuild(lesson, instruction) -> yangi pkg (tahrirdan keyin).
    dry_run=True — kanalga chiqarmaydi, faqat adminga ko'rsatadi.
    """
    preview_at = publish_at - datetime.timedelta(minutes=config.PREVIEW_MINUTES)
    _sleep_until(preview_at)

    # Kechikib ishga tushgan bo'lsa ham, admin kamida 5 daqiqa ko'rsin
    deadline = max(publish_at, _now() + datetime.timedelta(minutes=5))
    offset = _fresh_offset()
    token = f"edit:{int(time.time())}"

    _notify(f"🔔 <b>{deadline:%H:%M}</b> da kanalga chiqadigan post:")
    send_package(_admin(), pkg)
    issues = pkg.get("issues") or []
    note = ("\n\n🔎 Sifat nazorati tuzatgan joylar:\n" + "\n".join(f"• {e(i)}" for i in issues[:6])) if issues else ""
    button_msg = _notify(
        f"Hammasi to'g'rimi? Agar hech narsa bosmasangiz, post <b>{deadline:%H:%M}</b> da "
        f"avtomatik chiqadi.{note}",
        reply_markup={"inline_keyboard": [[{"text": "✏️ Tahrirlash", "callback_data": token}]]},
    )

    instruction, waiting_text = None, False
    while _now() < deadline and instruction is None:
        timeout = int(max(1, min(25, (deadline - _now()).total_seconds())))
        params = {"timeout": timeout, "allowed_updates": ["message", "callback_query"]}
        if offset:
            params["offset"] = offset
        for upd in _api("getUpdates", **params):
            offset = upd["update_id"] + 1
            cq = upd.get("callback_query")
            if cq and cq.get("data") == token and cq["from"]["id"] == _admin():
                _api("answerCallbackQuery", callback_query_id=cq["id"])
                _api("editMessageReplyMarkup", chat_id=_admin(),
                     message_id=button_msg["message_id"], reply_markup={"inline_keyboard": []})
                _notify("✍️ Nimani o'zgartiray? Bitta xabarda yozib yuboring.\n"
                        f"({config.EDIT_WAIT_MINUTES} daqiqa kutaman, keyin eski variant chiqadi.)")
                waiting_text = True
                deadline = max(deadline, _now() + datetime.timedelta(minutes=config.EDIT_WAIT_MINUTES))
                continue
            msg = upd.get("message")
            if waiting_text and msg and msg["chat"]["id"] == _admin() and msg.get("text"):
                instruction = msg["text"]
                break

    if instruction:
        _notify("⏳ Tuzatyapman, tayyor bo'lishi bilan qayta so'ramasdan kanalga chiqaraman.")
        try:
            pkg = rebuild(pkg["lesson"], instruction)
        except Exception as exc:  # tuzatish ishlamasa — eski variant chiqadi
            _notify(f"⚠️ Tuzatib bo'lmadi ({e(exc)}). Asl variant chiqariladi.")

    _sleep_until(publish_at)
    if dry_run:
        _notify("🧪 Sinov rejimi: kanalga chiqarilmadi. Yuqoridagi post shunday ko'rinadi.")
        if instruction:
            send_package(_admin(), pkg)
        return pkg
    send_package(config.CHANNEL_ID, pkg)
    _notify(f"✅ Post kanalga chiqdi: {e(config.CHANNEL_TAG)}")
    return pkg


def report_error(text):
    try:
        _notify(f"❌ Xatolik: {e(text)[:3500]}")
    except Exception:
        pass

"""5-agent: sifat nazorati — fransuzcha, talaffuz, o'zbekcha imlo va mazmunni tekshiradi."""
import json

from agents import gemini, researcher

PROMPT = """You are a strict editor for a Telegram channel that teaches French to Uzbek speakers.
Check this lesson JSON:
1. French: grammar, spelling, accents, natural usage. Fix every mistake.
2. "pron": the reading in Uzbek Latin letters must match real French pronunciation.
3. Uzbek: Latin script, correct spelling and apostrophes (o', g'), natural and friendly.
4. Translations ("uz") must match the French meaning.
5. Content must be polite, family-friendly, and not political or religious.
Return ONLY this JSON:
{"approved": true/false, "issues": ["short list of problems found, in Uzbek"],
 "fixed": <the full corrected lesson JSON, same format>}

Lesson:
"""


def check(lesson, rounds=2):
    """Tuzatilgan darsni va topilgan muammolar ro'yxatini qaytaradi."""
    all_issues = []
    for _ in range(rounds):
        result = gemini.ask(PROMPT + json.dumps(lesson, ensure_ascii=False), want_json=True)
        issues = result.get("issues") or []
        all_issues += issues
        fixed = result.get("fixed")
        if fixed:
            try:
                researcher.validate(fixed)
                lesson = fixed
            except ValueError:
                pass
        if result.get("approved") and not issues:
            break
    return lesson, all_issues

"""1-agent: rubrika bo'yicha internetdan izlab, dars-maqola tayyorlaydi."""
import json

import config
from agents import gemini

SCHEMA = f"""{{
  "topic": "short topic name in Uzbek (e.g. 'Kafeda buyurtma berish')",
  "title_uz": "catchy post title in Uzbek",
  "dialogue": [
    {{"speaker": "{config.FRENCH_GIRL}", "lang": "fr", "text": "what she says in French", "uz": "Uzbek translation"}},
    {{"speaker": "{config.UZBEK_GIRL}", "lang": "uz", "text": "Shohista, in Uzbek, repeats the French phrase, gives its reading in Uzbek letters in «...» and explains the meaning"}}
  ],
  "key_phrases": [{{"fr": "French phrase", "pron": "reading in Uzbek Latin letters", "uz": "meaning"}}],
  "tip_uz": "one short practical tip in Uzbek",
  "image_scene": "one-sentence scene description in English for an illustration (place, action, mood)"
}}"""

RULES = f"""
Rubric: «{config.RUBRIC}» — a Telegram channel teaching French to Uzbek speakers.
Format: a conversation between {config.FRENCH_GIRL} (French girl, speaks only French)
and {config.UZBEK_GIRL} (Uzbek girl in national dress). {config.FRENCH_GIRL} says something
useful in French; {config.UZBEK_GIRL} teaches the audience: repeats it, writes how to read it
with Uzbek Latin letters (o', g', sh, ch; use ö/ü only when unavoidable) and explains it simply.
Requirements:
- 4 to 8 dialogue lines, alternating speakers, starting with {config.FRENCH_GIRL}.
- Everyday, practical French (A1–A2 level). French must be 100% correct, with accents.
- Uzbek must be in Latin script, natural and friendly, correct apostrophes (o', g').
- 2 to 4 key_phrases taken from the dialogue.
- Do not repeat any topic from the "already used" list.
- Answer with ONLY the JSON object, no other text.
"""


def make_lesson(slot, used_topics):
    extra = {
        "text_audio": "This lesson will be read aloud as audio — keep sentences short and clear.",
        "photo": "This lesson becomes a picture post — keep it compact (4 lines of dialogue).",
        "video": "This lesson becomes a short vertical video — 4 to 6 short lines.",
    }[slot]
    prompt = (
        "Search the web for real, commonly used French expressions and good beginner lesson "
        "ideas, then write ONE new lesson.\n"
        f"{RULES}\n{extra}\n"
        f"Already used topics: {json.dumps(used_topics[-60:], ensure_ascii=False)}\n\n"
        f"JSON format:\n{SCHEMA}"
    )
    lesson = gemini.ask(prompt, want_json=True, search=True)
    validate(lesson)
    return lesson


def revise(lesson, instruction):
    """Admin «Tahrirlash» orqali yozgan ko'rsatma bo'yicha darsni tuzatadi."""
    prompt = (
        f"{RULES}\nHere is a lesson JSON:\n{json.dumps(lesson, ensure_ascii=False)}\n\n"
        f"The channel admin asked for this change (in Uzbek): «{instruction}»\n"
        "Apply the change carefully, keep everything else correct, and return the full "
        f"updated lesson as ONLY JSON in the same format:\n{SCHEMA}"
    )
    new = gemini.ask(prompt, want_json=True)
    validate(new)
    return new


def validate(lesson):
    for key in ("topic", "title_uz", "dialogue", "key_phrases", "tip_uz", "image_scene"):
        if not lesson.get(key):
            raise ValueError(f"Darsda '{key}' yo'q")
    if len(lesson["dialogue"]) < 2:
        raise ValueError("Dialog juda qisqa")
    for line in lesson["dialogue"]:
        if not {"speaker", "lang", "text"} <= line.keys():
            raise ValueError(f"Dialog qatori noto'g'ri: {line}")

"""2-agent: o'zimizning qisqa vertikal video — rasm + ovoz + fransuzcha/o'zbekcha subtitr.

Boshqa odamlarning videolari ishlatilmaydi (mualliflik huquqi), hamma narsa o'zimizniki.
"""
import subprocess
import textwrap
from pathlib import Path

import config
from agents import artist, voice

FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
FONT_BOLD = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"


def _subtitle(line):
    main = textwrap.fill(line["text"], 34)
    sub = textwrap.fill(line.get("uz", ""), 38) if line["lang"] == "fr" and line.get("uz") else ""
    return line["speaker"], main, sub


def _clip(image, audio, line, out_path, workdir):
    name, main, sub = _subtitle(line)
    (workdir / "name.txt").write_text(name, encoding="utf-8")
    (workdir / "main.txt").write_text(main, encoding="utf-8")
    (workdir / "sub.txt").write_text(sub or " ", encoding="utf-8")
    color = "0x2E6BD9" if line["speaker"] == config.FRENCH_GIRL else "0x1F9D6B"
    vf = (
        "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,"
        "drawbox=x=0:y=ih-640:w=iw:h=640:color=black@0.6:t=fill,"
        f"drawtext=fontfile={FONT_BOLD}:textfile={workdir/'name.txt'}:expansion=none:"
        f"fontsize=46:fontcolor=white:box=1:boxcolor={color}@0.95:boxborderw=14:x=60:y=h-600,"
        f"drawtext=fontfile={FONT_BOLD}:textfile={workdir/'main.txt'}:expansion=none:"
        "fontsize=52:fontcolor=white:line_spacing=14:x=(w-text_w)/2:y=h-500,"
        f"drawtext=fontfile={FONT}:textfile={workdir/'sub.txt'}:expansion=none:"
        "fontsize=42:fontcolor=0xFFD54A:line_spacing=12:x=(w-text_w)/2:y=h-250"
    )
    subprocess.run([
        "ffmpeg", "-y", "-loglevel", "error", "-loop", "1", "-i", str(image), "-i", str(audio),
        "-vf", vf, "-af", "apad=pad_dur=0.6", "-c:v", "libx264", "-preset", "veryfast",
        "-tune", "stillimage", "-pix_fmt", "yuv420p", "-r", "25", "-c:a", "aac", "-ar", "44100",
        "-ac", "2", "-shortest", str(out_path),
    ], check=True)
    return out_path


def make(lesson, workdir, clips=None, images=None):
    workdir = Path(workdir).resolve()
    if images is None:
        images = [
            artist.draw(lesson, workdir / "v1.png", aspect="9:16"),
            artist.draw(lesson, workdir / "v2.png", aspect="9:16",
                        variant="Close-up view of the two girls, slightly different angle."),
        ]
    if clips is None:
        clips, _ = voice.speak_dialogue(lesson, workdir)
    parts = []
    for i, (line, audio) in enumerate(zip(lesson["dialogue"], clips)):
        img = images[i % len(images)]
        parts.append(_clip(img, audio, line, workdir / f"part_{i:02d}.mp4", workdir))
    listing = workdir / "parts.txt"
    listing.write_text("".join(f"file '{p.name}'\n" for p in parts), encoding="utf-8")
    out = workdir / "video.mp4"
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0",
                    "-i", str(listing), "-c", "copy", "-movflags", "+faststart", str(out)],
                   check=True, cwd=workdir)
    return out

"""4-agent: ElevenLabs orqali dialogni audioga aylantiradi."""
import subprocess
import time
from pathlib import Path

import requests

import config

URL = "https://api.elevenlabs.io/v1/text-to-speech/{voice}?output_format=mp3_44100_128"
FALLBACK_MODEL = "eleven_multilingual_v2"


def _voice_for(speaker):
    voice = config.VOICE_CLAIRE if speaker == config.FRENCH_GIRL else config.VOICE_SHOHISTA
    if not voice:
        raise RuntimeError("VOICE_SHOHISTA / VOICE_CLAIRE o'rnatilmagan (GitHub Variables)")
    return voice


def speak(text, speaker, out_path):
    if not config.ELEVENLABS_API_KEY:
        raise RuntimeError("ELEVENLABS_API_KEY topilmadi (GitHub Secrets'ga qo'shing)")
    models = [config.ELEVEN_MODEL] + ([FALLBACK_MODEL] if config.ELEVEN_MODEL != FALLBACK_MODEL else [])
    last = None
    for model in models:
        for attempt in range(3):
            r = requests.post(
                URL.format(voice=_voice_for(speaker)),
                headers={"xi-api-key": config.ELEVENLABS_API_KEY},
                json={"text": text, "model_id": model},
                timeout=120,
            )
            if r.status_code == 200:
                Path(out_path).write_bytes(r.content)
                return out_path
            last = f"{r.status_code}: {r.text[:300]}"
            if r.status_code in (429, 500, 502, 503):
                time.sleep(8 * (attempt + 1))
                continue
            break  # boshqa model bilan urinib ko'ramiz
    raise RuntimeError(f"ElevenLabs xatosi — {last}")


def speak_dialogue(lesson, workdir):
    """Har bir qator uchun alohida mp3 va hammasi birlashgan mp3 qaytaradi."""
    workdir = Path(workdir)
    clips = []
    for i, line in enumerate(lesson["dialogue"]):
        clips.append(speak(line["text"], line["speaker"], workdir / f"line_{i:02d}.mp3"))
    full = workdir / "dialog.mp3"
    concat(clips, full)
    return clips, full


def concat(clips, out_path, pause=0.5):
    """Qatorlar orasiga qisqa pauza qo'yib, bitta audio qiladi."""
    inputs, filters = [], []
    for i, clip in enumerate(clips):
        inputs += ["-i", str(clip)]
        filters.append(f"[{i}:a]apad=pad_dur={pause}[a{i}]")
    joined = "".join(f"[a{i}]" for i in range(len(clips)))
    graph = ";".join(filters) + f";{joined}concat=n={len(clips)}:v=0:a=1[out]"
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", *inputs, "-filter_complex", graph,
                    "-map", "[out]", "-b:a", "128k", str(out_path)], check=True)
    return out_path


def duration(path):
    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                          "-of", "csv=p=0", str(path)], capture_output=True, text=True, check=True)
    return float(out.stdout.strip())
